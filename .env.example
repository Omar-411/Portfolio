# Production URL (canonical links, sitemap, Open Graph). Example: https://omarajimi.dev
NEXT_PUBLIC_SITE_URL=

# Optional booking link (Cal.com, Calendly...). When empty, the built-in booking dialog is used.
NEXT_PUBLIC_BOOKING_URL=

# Optional FormSubmit alias/token for the contact form. Falls back to the profile email.
NEXT_PUBLIC_FORMSUBMIT_ALIAS=

# Optional GitHub token (server-only) to raise the API rate limit for live repo data.
GITHUB_TOKEN=

# Real Google Calendar invitations for "Book a call" (see docs/google-calendar-setup.md).
# Leave empty to receive booking requests by email instead.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
