# Production URL (canonical links, sitemap, Open Graph). Example: https://omarajimi.dev
NEXT_PUBLIC_SITE_URL=

# Optional booking link (Cal.com, Calendly...). When empty, the built-in booking dialog is used.
NEXT_PUBLIC_BOOKING_URL=

# Optional FormSubmit alias/token for the contact form. Falls back to the profile email.
NEXT_PUBLIC_FORMSUBMIT_ALIAS=

# Optional Ethereum RPC for the Lab demos (defaults to a public endpoint).
NEXT_PUBLIC_ETH_RPC_URL=

# Optional GitHub token (server-only) to raise the API rate limit for live repo data.
GITHUB_TOKEN=

# Real Google Calendar invitations for "Book a call" (see docs/google-calendar-setup.md).
# Leave empty to receive booking requests by email instead.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# Visitor reviews (see docs/reviews-setup.md). The section and its navbar link only appear when all
# three are set. Vercel KV's KV_REST_API_URL / KV_REST_API_TOKEN names work too.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Any long random string (openssl rand -hex 32). It is the admin password and signs emailed links.
REVIEWS_ADMIN_SECRET=
# Private address of the admin page, e.g. k3x9-inbox-7q2m (8 to 64 letters, digits, - or _). The code is
# public, so set your own: the page then lives at /<this value> and /admin/reviews answers 404.
REVIEWS_ADMIN_PATH=
# Email for review notifications. Resend (https://resend.com, free) delivers reliably from a server;
# without it, FormSubmit is tried, which often refuses server-side requests.
RESEND_API_KEY=
# Where to send them (defaults to the profile email). With Resend's default sender this must be the
# email you signed up to Resend with, until you verify your own domain.
REVIEWS_NOTIFY_EMAIL=
# Optional sender, once you have a verified domain: "Portfolio <reviews@yourdomain.com>"
RESEND_FROM=
